{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "outside-the-boxplot",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-02-24",
	"compatibility_flags": ["nodejs_compat"],
	"routes": [{ "pattern": "otb.thedataareclean.com", "custom_domain": true }],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "outside-the-boxplot"
		}
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "outside-the-boxplot-media"
		}
	],
	// Co-editing rooms, one Durable Object per entry being edited
	"durable_objects": {
		"bindings": [{ "name": "EMDASH_ROOMS", "class_name": "EmDashRoom" }]
	},
	"exports": {
		"EmDashRoom": { "type": "durable-object", "storage": "sqlite" }
	},
	// Scheduled publishing and maintenance. Keep it, or scheduled posts never go live.
	"triggers": {
		"crons": ["* * * * *"]
	}
}
