<div class="newsletter-block newsletter-block--standalone">
  {# TODO: replace USERNAME with your Buttondown username to activate #}
  <form class="newsletter-form" action="https://buttondown.com/api/emails/embed-subscribe/USERNAME" method="post" target="popupwindow">
    <label for="email-newsletter">Email address</label>
    <div class="newsletter-form__row">
      <input
        type="email"
        id="email-newsletter"
        name="email"
        placeholder="your@email.com"
        required
        class="newsletter-form__input"
        autocomplete="email"
      >
      <button type="submit" class="newsletter-form__btn">Subscribe</button>
    </div>
  </form>
</div>
