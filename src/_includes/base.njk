<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  {% set pageTitle %}{% if post %}{{ post.title }} — {% elif title %}{{ title }} — {% endif %}{{ metadata.title }}{% endset %}
  {% set pageDesc %}{% if post and post.excerpt %}{{ post.excerpt }}{% elif description %}{{ description }}{% else %}{{ metadata.description }}{% endif %}{% endset %}
  {% set pageUrl %}{{ metadata.url }}{{ page.url }}{% endset %}
  {% set ogImage %}{{ metadata.url }}/og-image.png{% endset %}

  <title>{{ pageTitle }}</title>
  <meta name="description" content="{{ pageDesc }}">
  <meta name="theme-color" content="#4a7c59">
  <link rel="canonical" href="{{ pageUrl }}">

  <!-- Open Graph -->
  <meta property="og:site_name" content="{{ metadata.title }}">
  <meta property="og:type" content="{% if post %}article{% else %}website{% endif %}">
  <meta property="og:title" content="{{ pageTitle }}">
  <meta property="og:description" content="{{ pageDesc }}">
  <meta property="og:url" content="{{ pageUrl }}">
  <meta property="og:image" content="{{ ogImage }}">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  {% if post %}<meta property="article:published_time" content="{{ post.published_date }}">{% endif %}

  <!-- Twitter / X -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ pageTitle }}">
  <meta name="twitter:description" content="{{ pageDesc }}">
  <meta name="twitter:image" content="{{ ogImage }}">

  <!-- Icons & manifest -->
  <link rel="icon" href="/logo.png" type="image/png">
  <link rel="apple-touch-icon" href="/logo.png">
  <link rel="manifest" href="/manifest.webmanifest">

  <!-- Fonts & styles -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500&family=IBM+Plex+Serif:ital,wght@0,400;1,400&display=swap">
  <link rel="stylesheet" href="/css/styles.css">
  <link rel="alternate" type="application/atom+xml" title="{{ metadata.title }}" href="{{ metadata.url }}{{ metadata.feedPath }}">
</head>
<body>

  <header class="site-header">
    <nav class="nav" aria-label="Site navigation">
      <a href="/" class="nav__title" aria-label="Outside the Boxplot — home">
        <svg class="nav__glyph" viewBox="0 0 80 22" width="80" height="22" aria-hidden="true" overflow="visible">
          {% set markCircleFill = "#d0e8c8" %}
          <g stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round" stroke-linejoin="round" vector-effect="non-scaling-stroke">
            {% include "mark-paths.njk" %}
          </g>
          <text
            x="46" y="16"
            font-family="'IBM Plex Sans', system-ui, sans-serif"
            font-size="15" font-weight="500"
            fill="currentColor"
            letter-spacing="1"
          >tb</text>
        </svg>
      </a>
      <div class="nav__links">
        <a href="/about/" class="nav__link">About</a>
        <a href="/newsletter/" class="nav__link">Newsletter</a>
        <a href="{{ metadata.feedPath }}" class="nav__link">RSS</a>
      </div>
    </nav>
    <svg class="divider" viewBox="0 0 680 10" preserveAspectRatio="none" aria-hidden="true">
      <path d="M 0,5 C 100,2 220,8 380,4 C 520,1 610,7 680,5" fill="none" stroke="#d8d8d4" stroke-width="1.5" stroke-linecap="round"/>
    </svg>
  </header>

  <main class="main" id="main-content">
    {{ content | safe }}
  </main>

  <footer class="site-footer">
    <svg class="divider" viewBox="0 0 680 10" preserveAspectRatio="none" aria-hidden="true">
      <path d="M 0,5 C 80,8 180,2 320,6 C 460,3 580,7 680,4" fill="none" stroke="#d8d8d4" stroke-width="1.5" stroke-linecap="round"/>
    </svg>
    <p>© Outside the Boxplot</p>
  </footer>

</body>
</html>
