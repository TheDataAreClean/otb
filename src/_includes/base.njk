<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  {% set pageTitle %}{% if post %}{{ post.title }} — {% elif title %}{{ title }} — {% endif %}{{ metadata.title }}{% endset %}
  {% set pageDesc %}{% if post and post.excerpt %}{{ post.excerpt }}{% elif description %}{{ description }}{% else %}{{ metadata.description }}{% endif %}{% endset %}
  {% set pageUrl %}{{ metadata.url }}{{ page.url }}{% endset %}
  {% set ogImage %}{{ metadata.url }}/images/og-image.png{% endset %}

  <title>{{ pageTitle }}</title>
  <meta name="description" content="{{ pageDesc }}">
  <meta name="theme-color" content="#4a7c59">
  <link rel="canonical" href="{{ pageUrl }}">
  {% if noindex %}<meta name="robots" content="noindex">{% endif %}

  <!-- Open Graph -->
  <meta property="og:site_name" content="{{ metadata.title }}">
  <meta property="og:type" content="{% if post %}article{% else %}website{% endif %}">
  <meta property="og:title" content="{{ pageTitle }}">
  <meta property="og:description" content="{{ pageDesc }}">
  <meta property="og:url" content="{{ pageUrl }}">
  <meta property="og:image" content="{{ ogImage }}">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  {% if post %}<meta property="article:published_time" content="{{ post.published_date }}">{% endif %}

  <!-- Twitter / X -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ pageTitle }}">
  <meta name="twitter:description" content="{{ pageDesc }}">
  <meta name="twitter:image" content="{{ ogImage }}">

  <!-- Icons & manifest -->
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="icon" href="/favicon.ico" sizes="32x32">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">
  <link rel="manifest" href="/manifest.webmanifest">

  <!-- Fonts & styles -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500&family=IBM+Plex+Serif:ital,wght@0,400;0,700;1,400;1,700&display=swap">
  <link rel="stylesheet" href="/css/styles.css">
  <link rel="alternate" type="application/atom+xml" title="{{ metadata.title }}" href="{{ metadata.url }}{{ metadata.feedPath }}">
</head>
<body>

  <header class="site-header">
    <nav class="nav" aria-label="Site navigation">
      <a href="/" class="nav__title" aria-label="Outside the Boxplot — home">
        <span class="nav__glyph" aria-hidden="true">{{ "images/logo.svg" | svgContents | safe }}</span>
      </a>
      <div class="nav__links">
        <a href="/about/" class="nav__link">About</a>
        <a href="{{ metadata.feedPath }}" class="nav__link">RSS</a>
      </div>
    </nav>
    <svg class="divider" viewBox="0 0 680 10" preserveAspectRatio="none" aria-hidden="true">
      <path d="M 0,5 C 100,2 220,8 380,4 C 520,1 610,7 680,5" fill="none" stroke-width="1.5" stroke-linecap="round"/>
    </svg>
  </header>

  <main class="main" id="main-content">
    {{ content | safe }}
  </main>

  <footer class="site-footer">
    <svg class="divider" viewBox="0 0 680 10" preserveAspectRatio="none" aria-hidden="true">
      <path d="M 0,5 C 80,8 180,2 320,6 C 460,3 580,7 680,4" fill="none" stroke-width="1.5" stroke-linecap="round"/>
    </svg>
    <p>{{ metadata.copyright }}</p>
  </footer>

</body>
</html>
