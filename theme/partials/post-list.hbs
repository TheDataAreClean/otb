<ol class="post-list">
  {{#foreach posts}}
  <li class="post-list__item">
    <a href="{{url}}" class="post-list__link">
      <span class="post-list__title">{{title}}</span>
    </a>
    <div class="post-list__meta">
      {{> post-meta}}
    </div>
    {{#if custom_excerpt}}<p class="post-list__excerpt">{{custom_excerpt}}</p>{{/if}}
    {{#unless @last}}{{> post-divider}}{{/unless}}
  </li>
  {{else}}
  <li class="post-list__empty">No posts {{#is "tag"}}in this category {{/is}}yet.</li>
  {{/foreach}}
</ol>
{{pagination}}
